# Optional bearer token for THIS appliance's REST API. Empty/unset = auth off.
# When set, every /api/* request must send:  Authorization: Bearer <token>
DEJAVU_API_TOKEN=

# Optional credentials for FRIGATE's authenticated API port (8971) — not needed
# for the default internal :5000. Token wins over user/password.
DEJAVU_FRIGATE_TOKEN=
DEJAVU_FRIGATE_USER=
DEJAVU_FRIGATE_PASSWORD=

# Log verbosity of the container stdout (INFO default; DEBUG for forensics).
DEJAVU_LOG_LEVEL=INFO
