# ── Allowlist model ────────────────────────────────────────────────────────
# Ignore everything at the root by default, then re-include ONLY what ships

/*

# Public, shipped files:
!/.github/
!/.gitignore
!/.dockerignore
!/Dockerfile
!/LICENSE
!/README.md
!/SPEC.md
!/compose.example.yaml
!/config.example.yaml
!/requirements.txt
!/app/
!/tests/
!/homeassistant/
!/.gitattributes

# ...but never Python caches, even inside allowed directories:
__pycache__/
*.py[cod]
